rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /serviceCategories/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
